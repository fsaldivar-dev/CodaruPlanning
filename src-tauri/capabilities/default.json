{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Ventana local, di\u00e1logos expl\u00edcitos y documentos Kairo.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "kairo:default",
    "core:window:allow-destroy"
  ]
}
