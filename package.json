{
  "name": "codaru-planning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pretest": "npm run build:package",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "symbols": "swift scripts/export-symbols.swift",
    "context": "node scripts/context.mjs",
    "build:package": "npm run build --workspace @fsaldivar.dev/planning",
    "cli": "node packages/planning/dist/cli.js",
    "pack:planning": "npm pack --workspace @fsaldivar.dev/planning --pack-destination artifacts",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "@fsaldivar.dev/diagram": "^0.1.0",
    "@fsaldivar.dev/plugin": "^0.1.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "highlight.js": "^11.12.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
